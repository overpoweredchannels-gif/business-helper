      "args": "",
      "name": "is_current_user_owner_or_admin",
      "owner": "postgres",
      "config": [
        "search_path=public"
      ],
      "source": "\n  select exists (\n    select 1\n    from public.profiles p\n    where p.auth_user_id = auth.uid()\n      and p.role in ('owner', 'admin')\n      and p.is_active is true\n  )\n",
      "strict": false,
      "definer": true,
      "returns": "boolean",
      "language": "sql",
      "volatility": "s"
    },
    {
      "acl": [
        "=X/postgres",
        "anon=X/postgres",
        "authenticated=X/postgres",
        "postgres=X/postgres",
        "service_role=X/postgres"
      ],
      "args": "target_organization_id uuid",
      "name": "user_can_access_organization",
      "owner": "postgres",
      "config": [
        "search_path=public"
      ],
      "source": "\n  select exists (\n    select 1\n    from public.profiles p\n    where p.auth_user_id = auth.uid()\n      and p.organization_id = target_organization_id\n      and coalesce(p.is_active, true) = true\n  )\n",
      "strict": false,
      "definer": true,
      "returns": "boolean",
      "language": "sql",
      "volatility": "s"
    }
  ],
