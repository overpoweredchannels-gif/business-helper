{
  "name": "tradeos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:brain": "npx tsx scripts/run-brain-validation.ts",
    "test:gateway": "npx tsx scripts/run-gateway-validation.ts",
    "test:voice": "npx tsx scripts/test-voice-runtime.ts",
    "test:voice-demo": "npx tsx scripts/demo-voice-acceptance.ts",
    "test:assistant": "npx tsx scripts/test-assistant-flow.ts",
    "test:assistant-demo": "npx tsx scripts/demo-assistant-acceptance.ts",
    "test:customer": "npx tsx scripts/test-customer-flow.ts",
    "test:customer-demo": "npx tsx scripts/demo-customer-acceptance.ts",
    "test:supplier": "npx tsx scripts/test-supplier-flow.ts",
    "test:supplier-demo": "npx tsx scripts/demo-supplier-acceptance.ts",
    "test:financial": "npx tsx scripts/test-financial-flow.ts",
    "test:financial-demo": "npx tsx scripts/demo-financial-acceptance.ts",
    "test:business-intelligence": "npx tsx scripts/test-business-intelligence.ts",
    "test:business-intelligence-demo": "npx tsx scripts/demo-business-intelligence.ts",
    "test:invoice-number": "npx tsx scripts/test-invoice-number-service.ts",
    "test:invoice-ledger": "npx tsx scripts/test-invoice-flow.ts",
    "test": "npm run test:brain && npm run test:gateway && npm run test:financial && npm run test:business-intelligence && npm run test:invoice-number && npm run test:invoice-ledger",
    "test:startup": "npx tsx scripts/validate-startup.ts",
    "validate": "npm run typecheck && npm run test && npm run test:startup && npm run test:financial-demo",
    "validate:voice": "npm run typecheck && npm run test:voice && npm run test:voice-demo",
    "validate:assistant": "npm run typecheck && npm run test:assistant && npm run test:assistant-demo",
    "validate:customer": "npm run typecheck && npm run test:customer && npm run test:customer-demo",
    "validate:supplier": "npm run typecheck && npm run test:supplier && npm run test:supplier-demo",
    "validate:invoice": "npm run typecheck && npm run test:invoice-number && npm run test:invoice-ledger"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
